#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_app_setting_set_default --key=php_upload_max_filesize --value=1G

ynh_script_progression "Setting up source files..."
ynh_setup_source --dest_dir="$install_dir"
# initialize dist dir
mkdir -p "$install_dir/lichen-markdown/dist"
chown -R "$app:www-data" "$install_dir/lichen-markdown"
chmod -R u+rwX,g+rX,o= "$install_dir/lichen-markdown"

ynh_script_progression "Configuring PHP-FPM and NGINX..."
ynh_config_add_phpfpm
ynh_config_add_nginx

htpasswd -cb "$install_dir/lichen-markdown/.htpasswd" admin "$admin_password"
chown "root:www-data" "$install_dir/lichen-markdown/.htpasswd"
chmod 640 "$install_dir/lichen-markdown/.htpasswd"

ynh_script_progression "Configuring fail2ban..."
ynh_config_add_fail2ban --logpath="/var/log/nginx/$domain-error.log" --failregex='user ".*": password mismatch, client: <HOST>,'

ynh_script_progression "Building the public site..."
(cd "$install_dir/lichen-markdown/src" && ynh_exec_as_app php cms/build.php)
chown -R "$app:www-data" "$install_dir/lichen-markdown/dist"
chmod -R u+rwX,g+rX,o= "$install_dir/lichen-markdown/dist"

ynh_script_progression "Installation of $app completed"
