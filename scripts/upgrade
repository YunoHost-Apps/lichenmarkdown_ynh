#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_app_setting_set_default --key=php_upload_max_filesize --value=1G

ynh_script_progression "Removing the obsolete collaboration service..."
if [ -f "/etc/systemd/system/$app-y-websocket.service" ]; then
    ynh_systemctl --service="$app-y-websocket" --action=stop
    ynh_config_remove_systemd --service="$app-y-websocket"
fi
if yunohost service status "$app-y-websocket" >/dev/null 2>&1; then
    yunohost service remove "$app-y-websocket"
fi
if [ -f "/etc/logrotate.d/$app" ]; then
    ynh_config_remove_logrotate
fi

ynh_script_progression "Upgrading Lichen-Markdown code while preserving site content..."
upgrade_temp_dir="$install_dir/upgrade"
ynh_setup_source --dest_dir="$upgrade_temp_dir"
site_dir="$install_dir/lichen-markdown"
# The CMS is application code. Pages, themes, and styles in src can be edited by users.
cp -a "$site_dir/src/cms/shortcodes.php" "$upgrade_temp_dir/custom-shortcodes.php"
ynh_safe_rm "$site_dir/src/cms"
cp -a "$upgrade_temp_dir/lichen-markdown/src/cms" "$site_dir/src/cms"
cp -a "$upgrade_temp_dir/custom-shortcodes.php" "$site_dir/src/cms/shortcodes.php"
if [ -f "$site_dir/src/assets/yjs-bundle.iife.js" ]; then
    ynh_safe_rm "$site_dir/src/assets/yjs-bundle.iife.js"
fi
ynh_safe_rm "$upgrade_temp_dir"
chown -R "$app:www-data" "$site_dir"
chmod -R u+rwX,g+rX,o= "$site_dir"
chown root:www-data "$site_dir/.htpasswd"
chmod 640 "$site_dir/.htpasswd"

ynh_script_progression "Rebuilding the public site..."
(cd "$site_dir/src" && ynh_exec_as_app php cms/build.php)
chown -R "$app:www-data" "$site_dir/dist"
chmod -R u+rwX,g+rX,o= "$site_dir/dist"

ynh_script_progression "Updating PHP-FPM, NGINX and fail2ban..."
ynh_config_add_phpfpm
ynh_config_add_nginx
ynh_config_add_fail2ban --logpath="/var/log/nginx/$domain-error.log" --failregex='user ".*": password mismatch, client: <HOST>,'

ynh_script_progression "Upgrade of $app completed"
