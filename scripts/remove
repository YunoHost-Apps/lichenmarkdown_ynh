#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_config_remove_nginx
ynh_config_remove_phpfpm
ynh_config_remove_fail2ban

# Also handle installs removed before the migration to v1.5.0.
if [ -f "/etc/systemd/system/$app-y-websocket.service" ]; then
    ynh_systemctl --service="$app-y-websocket" --action=stop
    ynh_config_remove_systemd --service="$app-y-websocket"
fi
if yunohost service status "$app-y-websocket" >/dev/null 2>&1; then
    yunohost service remove "$app-y-websocket"
fi
if [ -f "/etc/logrotate.d/$app" ]; then
    ynh_config_remove_logrotate
fi
